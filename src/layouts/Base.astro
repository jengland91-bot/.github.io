---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description = site.description, path = '/', noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const canonical = new URL(path, site.url).toString();
const nav = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/reviews', label: 'Reviews', match: (p: string) => p.startsWith('/reviews') || p.startsWith('/blog') },
  { href: '/shop', label: 'Shop', match: (p: string) => p.startsWith('/shop') || p.startsWith('/gear') },
  { href: '/journal', label: 'Journal', match: (p: string) => p.startsWith('/journal') },
  { href: '/partners', label: 'Codes', match: (p: string) => p.startsWith('/partners') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
  </head>
  <body>
    <div class="ambient"></div>
    <div class="site">
      <header class="site-header" data-header>
        <div class="wrap header-inner">
          <a class="logo" href="/">
            <strong>J ENGLAND</strong>
            <span>Reviews · Shop · Field notes</span>
          </a>
          <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false">Menu</button>
          <div class="nav-row">
            <nav>
              {nav.map((item) => (
                <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>{item.label}</a>
              ))}
            </nav>
            <a
              class="btn btn-amazon header-shop"
              href={site.amazonStorefront}
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              Amazon shop
            </a>
          </div>
        </div>
      </header>
      <main>
        <div class="wrap page-pad">
          <slot />
        </div>
      </main>
      <footer class="site-footer">
        <div class="wrap">
          <div class="footer-grid">
            <div class="footer-brand">
              <strong>J ENGLAND</strong>
              <p>Independent reviews and the kit I actually use — photography, sim racing, cameras, and off-road.</p>
            </div>
            <div>
              <h3>Explore</h3>
              <a href="/reviews">Tech reviews</a>
              <a href="/journal">Journal</a>
              <a href="/about">About Josh</a>
              <a href="/links">Link hub</a>
            </div>
            <div>
              <h3>Shop</h3>
              <a href="/shop">Gear I use</a>
              <a href={site.amazonStorefront} target="_blank" rel="nofollow sponsored noopener">Amazon storefront</a>
              <a href="/partners">Partner codes</a>
              <a href="/shop#sim-racing">Sim racing</a>
            </div>
            <div>
              <h3>Connect</h3>
              <a href={site.socials.youtube}>YouTube</a>
              <a href={site.socials.twitch}>Twitch</a>
              <a href={site.socials.kick}>Kick</a>
              <a href={site.socials.instagram}>Instagram</a>
              <a href={site.socials.tiktok}>TikTok</a>
              <a href={`mailto:${site.email}`}>Email</a>
            </div>
          </div>
          <p class="footer-legal">© {new Date().getFullYear()} {site.author}. {site.disclosure}</p>
        </div>
      </footer>
    </div>
    <script>
      const header = document.querySelector('[data-header]');
      const toggle = document.querySelector('[data-menu-toggle]');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.textContent = open ? 'Close' : 'Menu';
      });
    </script>
  </body>
</html>
