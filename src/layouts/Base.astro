---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description = site.description, path = '/' } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} | ${site.tagline}`;
const canonical = new URL(path, site.url).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
  </head>
  <body>
    <div class="ambient"></div>
    <div class="site">
      <header class="site-header">
        <div class="wrap header-inner">
          <a class="logo" href="/">
            <strong>J ENGLAND</strong>
            <span>Blog · Gear · Links</span>
          </a>
          <nav>
            <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
            <a href="/blog" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
            <a href="/gear" aria-current={path.startsWith('/gear') ? 'page' : undefined}>Gear I Use</a>
            <a href="/partners" aria-current={path.startsWith('/partners') ? 'page' : undefined}>Codes</a>
            <a href="/links" aria-current={path.startsWith('/links') ? 'page' : undefined}>Links</a>
            <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
          </nav>
        </div>
      </header>
      <main>
        <div class="wrap">
          <slot />
        </div>
      </main>
      <footer class="site-footer">
        <div class="wrap footer-inner">
          <p>© {new Date().getFullYear()} {site.author}. {site.disclosure}</p>
          <p>
            <a class="text-link" href={site.socials.youtube}>YouTube</a>
            ·
            <a class="text-link" href={site.socials.instagram}>Instagram</a>
            ·
            <a class="text-link" href="/rss.xml">RSS</a>
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
