---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import PostCard from '../components/PostCard.astro';
import GearCard from '../components/GearCard.astro';
import PartnerCard from '../components/PartnerCard.astro';
import ShopBanner from '../components/ShopBanner.astro';
import Stars from '../components/Stars.astro';
import { site } from '../data/site';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const reviews = posts.filter((post) => post.data.kind === 'review');
const featuredReview = reviews.find((post) => post.data.featured) ?? reviews[0];
const journal = posts.filter((post) => post.data.kind === 'journal').slice(0, 3);

const gear = (await getCollection('gear')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const featuredGear = gear.filter((item) => item.data.featured).slice(0, 6);
const partners = await getCollection('partners');
---

<Base path="/">
  <section class="home-hero">
    <div class="hero-copy">
      <p class="kicker">{site.author}</p>
      <h1>Reviews, cameras, and the rig — written like a website, not a dump of links.</h1>
      <p class="lede">
        Independent tech reviews and field notes from a photographer, sim racer, and trophy truck co-driver.
        If I link it, I use it.
      </p>
      <div class="hero-actions">
        <a class="btn btn-amazon" href={site.amazonStorefront} target="_blank" rel="nofollow sponsored noopener">
          Shop my Amazon storefront
        </a>
        <a class="btn btn-ghost" href="/reviews">Read reviews</a>
        <a class="btn btn-ghost" href="/shop">Browse the shop</a>
      </div>
      <div class="trust-row">
        <span>Photographer</span>
        <span>Sim racer</span>
        <span>Trophy truck co-driver</span>
        <span>Amazon Associate</span>
      </div>
    </div>
    <aside class="hero-panel">
      <p class="kicker">Amazon storefront</p>
      <h2>Josh R England’s Amazon shop</h2>
      <p>The live storefront for sim racing, cameras, and desk kit. Same associate tag as every product card on this site.</p>
      <a class="btn btn-amazon" href={site.amazonStorefront} target="_blank" rel="nofollow sponsored noopener">
        Open amazon.com/shop/jengland91
      </a>
      <a class="text-link" href="/shop">Or shop products on this site →</a>
    </aside>
  </section>

  <Disclosure />

  <div class="section-head">
    <div>
      <p class="section-kicker">Start here</p>
      <h2>A full site, not just a blog.</h2>
    </div>
  </div>
  <div class="grid dest-grid">
    <a class="dest-card" href="/reviews">
      <span class="chip review">Reviews</span>
      <h3>Tech reviews</h3>
      <p>Ratings, verdicts, and the Amazon links that go with them.</p>
      <span class="go">Read reviews →</span>
    </a>
    <a class="dest-card" href="/shop">
      <span class="chip sim-racing">Shop</span>
      <h3>Gear I use</h3>
      <p>Filter by sim racing, cameras, photography, or off-road.</p>
      <span class="go">Browse shop →</span>
    </a>
    <a class="dest-card" href="/journal">
      <span class="chip content">Journal</span>
      <h3>Field notes</h3>
      <p>Longer writing from the shop, the desert, and the cockpit.</p>
      <span class="go">Open journal →</span>
    </a>
    <a class="dest-card" href={site.amazonStorefront} target="_blank" rel="nofollow sponsored noopener">
      <span class="chip photography">Amazon</span>
      <h3>Storefront</h3>
      <p>The official Amazon shop for this brand: jengland91.</p>
      <span class="go">Shop on Amazon →</span>
    </a>
  </div>

  {featuredReview && (
    <div class="section-head">
      <div>
        <p class="section-kicker">Featured review</p>
        <h2>What I’d tell a friend to buy.</h2>
      </div>
      <a href="/reviews">All reviews</a>
    </div>
  )}
  {featuredReview && (
    <a class="featured-review" href={`/blog/${featuredReview.id}`}>
      <div class="copy">
        <span class="chip review">Review</span>
        <h2 class="page-title" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">{featuredReview.data.title}</h2>
        <p class="page-lede">{featuredReview.data.description}</p>
        <Stars rating={featuredReview.data.rating} />
        {featuredReview.data.verdict && <p>{featuredReview.data.verdict}</p>}
        <span class="go text-link">Read the full review →</span>
      </div>
      <div class="art">Tech review</div>
    </a>
  )}

  <ShopBanner />

  <div class="section-head">
    <div>
      <p class="section-kicker">Shop</p>
      <h2>Featured gear</h2>
    </div>
    <a href="/shop">Full shop</a>
  </div>
  <div class="grid gear-grid">
    {featuredGear.map((item) => (
      <GearCard item={item} />
    ))}
  </div>

  {journal.length > 0 && (
    <>
      <div class="section-head">
        <div>
          <p class="section-kicker">Journal</p>
          <h2>Latest notes</h2>
        </div>
        <a href="/journal">All notes</a>
      </div>
      <div class="grid posts-grid">
        {journal.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </>
  )}

  <div class="section-head">
    <div>
      <p class="section-kicker">Partners</p>
      <h2>Codes that are not Amazon</h2>
    </div>
    <a href="/partners">All codes</a>
  </div>
  <div class="grid">
    {partners.map((partner) => (
      <PartnerCard partner={partner} />
    ))}
  </div>
</Base>
