---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import GearCard from '../components/GearCard.astro';
import Stars from '../components/Stars.astro';
import { site } from '../data/site';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const reviews = posts.filter((post) => post.data.kind === 'review');
const featuredReview = reviews.find((post) => post.data.featured) ?? reviews[0];

const gear = (await getCollection('gear')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const featuredGear = gear.filter((item) => item.data.featured).slice(0, 3);
---

<Base path="/">
  <section class="landing-hero">
    <div class="landing-hero__copy reveal">
      <p class="brand-mark">J England</p>
      <h1>Honest reviews. Real gear. One shop.</h1>
      <p class="lede">
        Tech reviews and Amazon picks from a photographer, sim racer, and trophy truck co-driver.
      </p>
      <div class="hero-actions">
        <a
          class="btn btn-amazon"
          href={site.amazonStorefront}
          target="_blank"
          rel="nofollow sponsored noopener"
        >
          Shop on Amazon
        </a>
        <a class="btn btn-ghost" href="/reviews">Read reviews</a>
      </div>
    </div>
    <div class="landing-hero__visual reveal reveal-delay" aria-hidden="true">
      <div class="visual-plane">
        <span>Reviews · Shop · Field notes</span>
      </div>
    </div>
  </section>

  <div class="landing-quiet">
    <Disclosure />
  </div>

  {featuredReview && (
    <section class="landing-block">
      <div class="section-head">
        <div>
          <p class="section-kicker">Featured</p>
          <h2>Latest review</h2>
        </div>
        <a href="/reviews">All reviews</a>
      </div>
      <a class="featured-review" href={`/blog/${featuredReview.id}`}>
        <div class="copy">
          <span class="chip review">Review</span>
          <h3 class="featured-title">{featuredReview.data.title}</h3>
          <p class="page-lede">{featuredReview.data.description}</p>
          <Stars rating={featuredReview.data.rating} />
          <span class="text-link">Read the review →</span>
        </div>
        <div class="art" aria-hidden="true">Review</div>
      </a>
    </section>
  )}

  <section class="landing-block">
    <div class="section-head">
      <div>
        <p class="section-kicker">Shop</p>
        <h2>Gear I use</h2>
      </div>
      <a href="/shop">Full shop</a>
    </div>
    <div class="grid gear-grid">
      {featuredGear.map((item) => (
        <GearCard item={item} />
      ))}
    </div>
  </section>

  <section class="landing-cta">
    <p class="kicker">Amazon storefront</p>
    <h2>Browse the full kit on Amazon.</h2>
    <p>Same products as this site — sim racing, cameras, and desk gear.</p>
    <a
      class="btn btn-amazon"
      href={site.amazonStorefront}
      target="_blank"
      rel="nofollow sponsored noopener"
    >
      Open amazon.com/shop/jengland91
    </a>
  </section>
</Base>
