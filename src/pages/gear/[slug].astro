---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import PostCard from '../../components/PostCard.astro';
import AmazonButton from '../../components/AmazonButton.astro';
import { categoryLabels } from '../../data/site';

export async function getStaticPaths() {
  const gear = await getCollection('gear');
  return gear.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const posts = (await getCollection('posts')).filter(
  (post) => !post.data.draft && post.data.gear.includes(item.id),
);
---

<Base title={item.data.title} description={item.data.description} path={`/gear/${item.id}`}>
  <article class="article">
    <header>
      <p class="kicker">{categoryLabels[item.data.category]}</p>
      <h1 class="page-title">{item.data.title}</h1>
      <p class="page-lede">{item.data.description}</p>
      {item.data.usedFor && <p class="meta">Used for: {item.data.usedFor}</p>}
      <div class="hero-actions">
        <AmazonButton href={item.data.amazonUrl} />
        <a class="btn btn-ghost" href="/shop">Back to shop</a>
      </div>
    </header>
    <Disclosure />
    <div class="prose">
      <Content />
    </div>
  </article>

  {posts.length > 0 && (
    <section class="related">
      <div class="section-head">
        <h2>Mentioned in</h2>
        <a href="/reviews">Reviews</a>
      </div>
      <div class="grid posts-grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )}
</Base>
