---
import { extraOverlays, overlayScenes, overlayUrl } from '../../data/obs';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Overlay preview · J England</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #08090d;
        --line: #232833;
        --text: #f3f1ec;
        --muted: #9aa3b2;
        --cyan: #3ee0ea;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: Outfit, system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        padding: 32px 28px 80px;
      }
      h1 { font-family: Fraunces, Georgia, serif; font-size: 42px; margin: 8px 0 10px; }
      .lede { color: var(--muted); max-width: 720px; line-height: 1.6; }
      a { color: var(--cyan); }
      .kicker { letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); font-size: 12px; font-weight: 700; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 22px; margin-top: 28px; }
      .card {
        border: 1px solid var(--line);
        border-radius: 18px;
        overflow: hidden;
        background: #10131a;
      }
      .card header { padding: 12px 14px; display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
      .card h2 { font-size: 16px; }
      .card p { color: var(--muted); font-size: 13px; }
      .fit {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: #05060a;
      }
      .fit.horizontal { aspect-ratio: 16 / 9; }
      .fit.vertical { aspect-ratio: 9 / 16; max-width: 280px; margin: 0 auto; }
      .fit iframe {
        position: absolute;
        top: 0;
        left: 0;
        border: 0;
        transform-origin: top left;
        pointer-events: none;
      }
      .urls { padding: 10px 14px 14px; display: flex; flex-direction: column; gap: 6px; }
      code { font-size: 11px; color: var(--muted); word-break: break-all; }
      .row { display: flex; gap: 10px; flex-wrap: wrap; margin: 18px 0 8px; }
      .btn {
        display: inline-flex;
        padding: 10px 14px;
        border-radius: 999px;
        background: var(--cyan);
        color: #081016;
        font-weight: 700;
        text-decoration: none;
      }
      .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
    </style>
  </head>
  <body>
    <p class="kicker">OBS browser sources</p>
    <h1>Overlay wall</h1>
    <p class="lede">
      These are the live browser-source URLs. After Netlify deploys, paste them into OBS at 1920×1080 (or 1080×1920 for vertical).
      Add <code>?game=BeamNG</code> or <code>?minutes=8</code> to any URL. <a href="/obs">Full OBS setup</a>.
    </p>
    <div class="row">
      <a class="btn" href="/obs">Setup guide</a>
      <a class="btn ghost" href="/obs-pack/J-England.json" download>Download scene collection</a>
    </div>

    <p class="kicker" style="margin-top:28px;">Horizontal 16:9</p>
    <div class="grid">
      {overlayScenes.map((scene) => (
        <article class="card">
          <header>
            <h2>{scene.name}</h2>
            <p>{scene.job}</p>
          </header>
          <div class="fit horizontal" data-fit="horizontal">
            <iframe src={`/overlays/${scene.id}?preview=1`} width="1920" height="1080" title={scene.name}></iframe>
          </div>
          <div class="urls">
            <code>{overlayUrl(scene.id)}</code>
          </div>
        </article>
      ))}
    </div>

    <p class="kicker" style="margin-top:36px;">Vertical 9:16 — YouTube Shorts / Kick / TikTok-shaped</p>
    <div class="grid">
      {overlayScenes.map((scene) => (
        <article class="card">
          <header>
            <h2>{scene.name} vertical</h2>
            <p>Same scene, 1080×1920 chrome. Duplicate in Aitum Vertical and scene-link the names.</p>
          </header>
          <div class="fit vertical" data-fit="vertical">
            <iframe src={`/overlays/v/${scene.id}?preview=1`} width="1080" height="1920" title={`${scene.name} vertical`}></iframe>
          </div>
          <div class="urls">
            <code>{overlayUrl(scene.id, true)}</code>
          </div>
        </article>
      ))}
    </div>

    <p class="kicker" style="margin-top:36px;">Extras</p>
    <div class="grid">
      {extraOverlays.map((scene) => (
        <article class="card">
          <header>
            <h2>{scene.name}</h2>
            <p>{scene.job}</p>
          </header>
          <div class="fit horizontal" data-fit="horizontal">
            <iframe src={`/overlays/${scene.id}?preview=1`} width="1920" height="1080" title={scene.name}></iframe>
          </div>
          <div class="urls">
            <code>{overlayUrl(scene.id)}</code>
          </div>
        </article>
      ))}
    </div>

    <script>
      const fit = () => {
        document.querySelectorAll('[data-fit]').forEach((box) => {
          const iframe = box.querySelector('iframe');
          if (!(iframe instanceof HTMLIFrameElement) || !(box instanceof HTMLElement)) return;
          const srcW = box.dataset.fit === 'vertical' ? 1080 : 1920;
          iframe.style.transform = `scale(${box.clientWidth / srcW})`;
        });
      };
      fit();
      new ResizeObserver(fit).observe(document.body);
    </script>
  </body>
</html>
