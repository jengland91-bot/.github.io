---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { streamingKit } from '../data/streaming';

const { verdict, brand, bios, panels, scenes, assets, checklist } = streamingKit;
---

<Base
  title="Streaming kit"
  description="Josh England streaming brand kit — Meld scenes, Twitch/Kick/YouTube bios, and downloadable banners."
  path="/streaming"
>
  <section class="hero">
    <p class="kicker">Streaming brand kit</p>
    <h1>Step up the stream without rebuilding from zero.</h1>
    <p class="lede">
      Keep <strong>{verdict.software}</strong> for Twitch + Kick + YouTube. Use one look on Kick and Twitch, a broader creator look on YouTube, and the scene set below so every go-live feels intentional.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#assets">Download assets</a>
      <a class="btn btn-ghost" href="#bios">Copy bios</a>
    </div>
  </section>

  <section class="stream-block" id="software">
    <p class="kicker">Software</p>
    <h2 class="page-title" style="font-size:clamp(1.6rem,3vw,2.2rem);">Stay on Meld Studio</h2>
    <p class="page-lede">{verdict.why}</p>
    <ul class="stream-list">
      <li><strong>OBS:</strong> {verdict.whenObs}</li>
      <li><strong>Streamlabs:</strong> {verdict.whenStreamlabs}</li>
    </ul>
  </section>

  <section class="stream-block" id="brand">
    <p class="kicker">Brand</p>
    <h2>One system, three platforms</h2>
    <p class="page-lede">{brand.sameEverywhere} Voice: {brand.voice}</p>
    <div class="swatch-row">
      {brand.colors.map((color) => (
        <div class="swatch">
          <span style={`background:${color}`}></span>
          <code>{color}</code>
        </div>
      ))}
    </div>
  </section>

  <section class="stream-block" id="assets">
    <p class="kicker">Assets</p>
    <h2>Banners, avatar, offline screens</h2>
    <p class="page-lede">Sized for upload. Preview below, then download the exact files.</p>
    <div class="asset-preview-grid">
      <figure>
        <img src="/branding/avatar-800x800.png" alt="JE monogram avatar" width="220" height="220" />
        <figcaption>Avatar</figcaption>
      </figure>
      <figure>
        <img src="/branding/twitch-banner-1200x480.png" alt="Twitch profile banner" />
        <figcaption>Twitch banner</figcaption>
      </figure>
      <figure>
        <img src="/branding/kick-banner-1280x700.png" alt="Kick channel banner" />
        <figcaption>Kick banner</figcaption>
      </figure>
      <figure>
        <img src="/branding/youtube-banner-2560x1440.png" alt="YouTube channel banner" />
        <figcaption>YouTube banner</figcaption>
      </figure>
    </div>
    <div class="hub-list" style="margin-top:18px;">
      {assets.map((asset, index) => (
        <a class="hub-row" href={asset.href} download>
          <span class="num">{String(index + 1).padStart(2, '0')}</span>
          <span>{asset.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="stream-block" id="bios">
    <p class="kicker">Profiles</p>
    <h2>Kick + Twitch (matched) · YouTube (broader)</h2>
    <div class="bio-grid">
      <article class="bio-card">
        <h3>Twitch about</h3>
        <pre class="copy-block">{bios.twitch}</pre>
        <p class="hint">
          Channel:
          <a class="text-link" href={site.socials.twitch} target="_blank" rel="noopener">{site.socials.twitch}</a>
        </p>
      </article>
      <article class="bio-card">
        <h3>Kick bio</h3>
        <pre class="copy-block">{bios.kick}</pre>
        <p class="hint">
          Channel:
          <a class="text-link" href={site.socials.kick} target="_blank" rel="noopener">{site.socials.kick}</a>
        </p>
      </article>
      <article class="bio-card bio-wide">
        <h3>YouTube About</h3>
        <pre class="copy-block">{bios.youtube}</pre>
        <p class="hint">Short channel description line: <em>{bios.youtubeHandleShort}</em></p>
      </article>
    </div>
  </section>

  <section class="stream-block" id="panels">
    <p class="kicker">Twitch / Kick panels</p>
    <h2>Four panels, one story</h2>
    <div class="panel-grid">
      {panels.map((panel) => (
        <article class="panel-card">
          <img src={panel.image} alt={`${panel.title} panel graphic`} width="320" height="160" />
          <h3>{panel.title}</h3>
          <p>{panel.body}</p>
          <a class="text-link" href={panel.link} target="_blank" rel="noopener">Panel link →</a>
          <div>
            <a class="text-link" href={panel.image} download>Download graphic</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="stream-block" id="scenes">
    <p class="kicker">Meld scenes</p>
    <h2>Six scenes that cover almost every stream</h2>
    <p class="page-lede">
      In Meld, create these scene names exactly. Drop the SVG/PNG from <code>/branding/</code> as Image or Browser layers. Multistream targets stay as you have them.
    </p>
    <div class="scene-grid">
      {scenes.map((scene) => (
        <article class="scene-card">
          <h3>{scene.name}</h3>
          <p class="scene-job">{scene.job}</p>
          <ul class="stream-list">
            {scene.layers.map((layer) => (
              <li>{layer}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="stream-block" id="checklist">
    <p class="kicker">Launch checklist</p>
    <h2>Do this once, then go live</h2>
    <ol class="stream-olist">
      {checklist.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
    <div class="hero-actions" style="margin-top:20px;">
      <a class="btn btn-primary" href="/links">Open links hub</a>
      <a class="btn btn-ghost" href={site.socials.youtube} target="_blank" rel="noopener">YouTube channel</a>
    </div>
  </section>
</Base>

<style>
  .stream-block {
    margin-top: 48px;
    display: grid;
    gap: 14px;
  }

  .stream-list {
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--muted);
  }

  .stream-list li {
    padding: 12px 14px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .stream-olist {
    color: var(--muted);
    padding-left: 1.2rem;
    display: grid;
    gap: 10px;
  }

  .swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .swatch {
    display: grid;
    gap: 8px;
    justify-items: center;
  }

  .swatch span {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  .swatch code {
    color: var(--faint);
    font-size: 0.75rem;
  }

  .asset-preview-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .asset-preview-grid figure {
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .asset-preview-grid img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #000;
  }

  .asset-preview-grid figcaption {
    color: var(--faint);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .bio-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .bio-wide {
    grid-column: 1 / -1;
  }

  .bio-card,
  .panel-card,
  .scene-card {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px;
    display: grid;
    gap: 10px;
  }

  .bio-card h3,
  .panel-card h3,
  .scene-card h3 {
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .copy-block {
    white-space: pre-wrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text);
    background: #0a0c10;
    border-radius: 12px;
    padding: 14px;
    border: 1px solid var(--line);
    overflow-x: auto;
  }

  .hint {
    color: var(--faint);
    font-size: 0.82rem;
  }

  .panel-grid,
  .scene-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .panel-card p,
  .scene-job {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .scene-job {
    font-weight: 600;
    color: var(--text);
  }

  @media (max-width: 800px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
