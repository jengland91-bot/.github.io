---
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '../data/site';
import AmazonButton from './AmazonButton.astro';

interface Props {
  item: CollectionEntry<'gear'>;
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
---

<article class="card product-card">
  <div class:list={['media', item.data.category]}>{categoryLabels[item.data.category]}</div>
  <span class:list={['chip', item.data.category]}>{categoryLabels[item.data.category]}</span>
  <h3><a href={`/gear/${item.id}`}>{item.data.title}</a></h3>
  {!compact && <p>{item.data.description}</p>}
  {item.data.usedFor && <p class="meta">Used for: {item.data.usedFor}</p>}
  <AmazonButton href={item.data.amazonUrl} />
</article>
