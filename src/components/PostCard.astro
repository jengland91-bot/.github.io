---
import type { CollectionEntry } from 'astro:content';
import Stars from './Stars.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const kindLabel = post.data.kind === 'review' ? 'Review' : 'Journal';
---

<a class="card" href={`/blog/${post.id}`}>
  <span class="meta">{date} · {kindLabel}</span>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <Stars rating={post.data.rating} />
  <span class:list={['chip', post.data.kind === 'review' ? 'review' : undefined]}>{post.data.tags[0] ?? kindLabel}</span>
</a>
