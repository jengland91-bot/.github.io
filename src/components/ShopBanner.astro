---
import { site } from '../data/site';
---

<section class="shop-banner">
  <div>
    <p class="kicker">Amazon storefront</p>
    <h2>Shop the kit I actually run.</h2>
    <p>Same products as this site, in my Amazon shop — sim racing, cameras, mics, and the rest of the bag. Purchases through this link support the work at no extra cost to you.</p>
  </div>
  <a
    class="btn btn-amazon"
    href={site.amazonStorefront}
    target="_blank"
    rel="nofollow sponsored noopener"
  >
    Open Amazon shop
  </a>
</section>
