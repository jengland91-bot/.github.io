  <library_effects>
    <effect id="Colmesh_Material-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">1 0 1 1</color>
            </diffuse>
            <transparent opaque="A_ONE">
              <color sid="alpha">0 0 0 0.15</color>
            </transparent>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="logo-effect">
      <profile_COMMON>
        <newparam sid="arch_logo_png-surface">
          <surface type="2D">
            <init_from>arch_logo_png</init_from>
          </surface>
        </newparam>
        <newparam sid="arch_logo_png-sampler">
          <sampler2D>
            <source>arch_logo_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="arch_logo_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="block-effect">
      <profile_COMMON>
        <newparam sid="arch_block_png-surface">
          <surface type="2D">
            <init_from>arch_block_png</init_from>
          </surface>
        </newparam>
        <newparam sid="arch_block_png-sampler">
          <sampler2D>
            <source>arch_block_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="arch_block_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="tube-effect">
      <profile_COMMON>
        <newparam sid="arch_tube_png-surface">
          <surface type="2D">
            <init_from>arch_tube_png</init_from>
          </surface>
        </newparam>
        <newparam sid="arch_tube_png-sampler">
          <sampler2D>
            <source>arch_tube_png-surface</source>
