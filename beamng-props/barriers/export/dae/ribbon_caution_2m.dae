  <library_effects>
    <effect id="BR_ribbon-effect">
      <profile_COMMON>
        <newparam sid="ribbon_caution_png-surface">
          <surface type="2D">
            <init_from>ribbon_caution_png</init_from>
          </surface>
        </newparam>
        <newparam sid="ribbon_caution_png-sampler">
          <sampler2D>
            <source>ribbon_caution_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="ribbon_caution_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="ribbon_caution_png" name="ribbon_caution_png">
      <init_from>ribbon_caution.png</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="BR_ribbon-material" name="BR_ribbon">
      <instance_effect url="#BR_ribbon-effect"/>
    </material>
  </library_materials>
