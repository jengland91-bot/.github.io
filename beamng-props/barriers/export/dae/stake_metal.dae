  <library_effects>
    <effect id="BR_metal-effect">
      <profile_COMMON>
        <newparam sid="stake_metal_png-surface">
          <surface type="2D">
            <init_from>stake_metal_png</init_from>
          </surface>
        </newparam>
        <newparam sid="stake_metal_png-sampler">
          <sampler2D>
            <source>stake_metal_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="stake_metal_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">0.8</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
