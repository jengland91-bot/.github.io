  <library_effects>
    <effect id="hay_006-effect">
      <profile_COMMON>
        <newparam sid="hay_gold_png-surface">
          <surface type="2D">
            <init_from>hay_gold_png</init_from>
          </surface>
        </newparam>
        <newparam sid="hay_gold_png-sampler">
          <sampler2D>
            <source>hay_gold_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="hay_gold_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Colmesh_Material-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
