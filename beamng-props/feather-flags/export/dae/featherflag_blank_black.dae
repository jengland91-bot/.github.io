  <library_effects>
    <effect id="FF_pole-effect">
      <profile_COMMON>
        <newparam sid="flag_pole_png-surface">
          <surface type="2D">
            <init_from>flag_pole_png</init_from>
          </surface>
        </newparam>
        <newparam sid="flag_pole_png-sampler">
          <sampler2D>
            <source>flag_pole_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="flag_pole_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">0.7</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
