  <library_effects>
    <effect id="body_006-effect">
      <profile_COMMON>
        <newparam sid="pp_body_blue_png-surface">
          <surface type="2D">
            <init_from>pp_body_blue_png</init_from>
          </surface>
        </newparam>
        <newparam sid="pp_body_blue_png-sampler">
          <sampler2D>
            <source>pp_body_blue_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="pp_body_blue_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
