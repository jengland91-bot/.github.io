  <library_effects>
    <effect id="rock-effect">
      <profile_COMMON>
        <newparam sid="rock_tan_png-surface">
          <surface type="2D">
            <init_from>rock_tan_png</init_from>
          </surface>
        </newparam>
        <newparam sid="rock_tan_png-sampler">
          <sampler2D>
            <source>rock_tan_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="rock_tan_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
