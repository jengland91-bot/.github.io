  <library_effects>
    <effect id="stake-effect">
      <profile_COMMON>
        <newparam sid="fence_post_png-surface">
          <surface type="2D">
            <init_from>fence_post_png</init_from>
          </surface>
        </newparam>
        <newparam sid="fence_post_png-sampler">
          <sampler2D>
            <source>fence_post_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="fence_post_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">0.2</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
