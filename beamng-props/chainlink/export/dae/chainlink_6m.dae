          </instance_geometry>
        </node>
        <node id="mesh" name="mesh" type="NODE">
          <matrix sid="transform">1 0 0 3 0 1 0 0 0 0 1 0.9 0 0 0 1</matrix>
          <instance_geometry url="#Cube-mesh" name="mesh">
            <bind_material>
              <technique_common>
                <instance_material symbol="CL_mesh-material" target="#CL_mesh-material">
                  <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
              </technique_common>
            </bind_material>
          </instance_geometry>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>