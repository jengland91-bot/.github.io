            </bind_material>
          </instance_geometry>
        </node>
        <node id="latch" name="latch" type="NODE">
          <matrix sid="transform">1 0 0 1.15 0 1 0 -0.06 0 0 1 0.99 0 0 0 1</matrix>
          <instance_geometry url="#Cube_001-mesh" name="latch">
