  <library_geometries>
    <geometry id="p400_rock_b-mesh" name="p400_rock_b">
      <mesh>
        <source id="p400_rock_b-pos"><float_array id="p400_rock_b-pos-array" count="36">-0.5349 -0.0418 0.5845 0.3547 0.1440 0.5759 -0.5760 0.0619 0.5305 0.5057 0.0782 0.5181 -0.0263 0.7456 0.3723 -0.0079 0.8526 0.3983 0.0101 -0.8804 0.3646 0.0150 -0.7826 0.4076 0.8091 -0.4373 0.0971 0.7588 0.3616 0.0605 -0.8226 -0.4897 0.1180 -0.8321 0.5168 0.0907</float_array>
          <technique_common><accessor source="#p400_rock_b-pos-array" count="12" stride="3">
            <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
          </accessor></technique_common>
        </source>
        <vertices id="p400_rock_b-verts"><input semantic="POSITION" source="#p400_rock_b-pos"/></vertices>
        <triangles material="p400_rock_mat" count="20">
